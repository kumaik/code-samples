# Cognito パスワード認証クライアント（シークレットあり）
COGNITO_REGION=ap-northeast-1
COGNITO_USER_POOL_ID=ap-northeast-1_XXXXXXXXX
COGNITO_CLIENT_ID=your-client-id
COGNITO_CLIENT_SECRET=your-client-secret

# Cognito パスキー専用クライアント（シークレットなし）
COGNITO_PASSKEY_CLIENT_ID=your-passkey-client-id

# Flask セッション署名キー（任意の文字列）
SECRET_KEY=your-secret-key

# Entra Verified ID（アプリ登録 — VC Request Service API 権限が必要）
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_SECRET=your-azure-client-secret

# Verified ID 設定
VC_DID_AUTHORITY=did:web:your-domain.com
VC_CREDENTIAL_MANIFEST=https://verifiedid.did.msidentity.com/v1.0/...
VC_API_ENDPOINT=https://verifiedid.did.msidentity.com/v1.0/verifiableCredentials/

# コールバック受信 URL（ローカル開発時は ngrok の https URL）
VC_CALLBACK_BASE_URL=https://xxxx-xxxx.ngrok-free.app
